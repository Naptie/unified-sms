# Server
HOST=127.0.0.1
PORT=3000

# API authentication secret — shared with all authorized client apps
API_SECRET=your-secret-key-here

# Optional reverse proxy URL
REVERSE_PROXY=https://your-proxy.com/?url=

# Aliyun (Alibaba Cloud) — handles +86 China Mainland numbers
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_SIGN_NAME=your-sign-name
ALIYUN_TEMPLATE_CODE=your-template-code

# Telegram — verification fallback for numbers outside China Mainland.
# All three of TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_URL and TELEGRAM_WEBHOOK_SECRET
# must be set for the fallback to activate; leave them empty to disable it.
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=https://sms.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=random-long-secret-shared-with-telegram
TELEGRAM_SESSION_TTL=600
TELEGRAM_MAX_CONNECTIONS=5
