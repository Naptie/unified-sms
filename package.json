{
  "name": "unified-sms",
  "version": "0.1.0",
  "description": "The easiest SMS hub — unified OTP sending and verification across multiple providers and regions",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --external '@alicloud/dypnsapi20170525' --external '@alicloud/openapi-client' --external '@alicloud/tea-typescript' --external '@alicloud/tea-util' --outfile build/index.js",
    "build:data": "bun run scripts/build-regions-data.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-typescript": "^1.8.0",
    "@alicloud/tea-util": "^1.4.11",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@elysia/eden": "^1.4.10",
    "bun-types": "latest",
    "libphonenumber-js": "^1.13.10",
    "oxfmt": "^0.51.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
